{
  "kind": "collectionType",
  "collectionName": "inboxes",
  "info": {
    "singularName": "inbox",
    "pluralName": "inboxes",
    "displayName": "Inbox",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "message": {
      "type": "text"
    },
    "email": {
      "type": "email",
      "required": true
    },
    "store": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::store.store"
    },
    "order": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::order.order",
      "inversedBy": "inboxMessages"
    },
    "archived": {
      "type": "boolean"
    },
    "parentMessageId": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::inbox.inbox"
    },
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "direction": {
      "type": "string",
      "default": "incoming"
    },
    "threadKey": {
      "type": "string"
    },
    "routingKey": {
      "type": "string"
    },
    "fromAddress": {
      "type": "email"
    },
    "toAddress": {
      "type": "email"
    },
    "messageId": {
      "type": "string"
    },
    "bodyHtml": {
      "type": "text"
    },
    "metadata": {
      "type": "component",
      "repeatable": false,
      "component": "common.inbox-metadata"
    },
    "estado": {
      "type": "string",
      "default": "new"
    }
  }
}
